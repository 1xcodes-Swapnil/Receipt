# Receipts — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   # backend reads .env automatically via pydantic-settings


# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no configuration needed)
# DATABASE_URL=sqlite:///./database/receipts.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/receipts

DATABASE_URL=sqlite:///./database/receipts.db


# ── GitHub Integration ────────────────────────────────────────────────────────
# Personal access token with repo read scope.
# Required for GitHubRepositoryProvider.
# Without this, the system falls back to LocalRepositoryProvider.
GITHUB_TOKEN=ghp_your_token_here


# ── Application ───────────────────────────────────────────────────────────────
APP_VERSION=0.8.0
DEBUG=false

# Maximum parallel agents per review (default: 4)
MAX_PARALLEL_AGENTS=4

# Absolute path to the demo repository used when no path override is given.
# Leave blank to use the bundled demo/repository.
# DEMO_REPO_PATH=


# ── Replay Engine ─────────────────────────────────────────────────────────────
# Maximum number of replay cases to run in one batch (0 = unlimited)
REPLAY_MAX_CASES=0


# ── Advanced Strategies (Phase 6) ────────────────────────────────────────────
# Global iteration budget for fuzzing and property-based testing
STRATEGY_MAX_ITERATIONS=50

# Seed override — leave blank for per-run deterministic seed
# STRATEGY_SEED=42

# Maximum wall-clock seconds for a single strategy execution
STRATEGY_TIMEOUT_SECONDS=30


# ── Immunity Pipeline (Phase 7) ──────────────────────────────────────────────
# Maximum fix+verify retry cycles
IMMUNITY_MAX_FIX_RETRIES=3


# ── Audit ─────────────────────────────────────────────────────────────────────
# Set to true to emit audit events to stdout as well as the DB
AUDIT_LOG_STDOUT=false
